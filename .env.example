# Exécution : Supabase Transaction Pooler (port 6543 en production sans serveur).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"
# Migrations : Supabase Session Pooler (port 5432) ou connexion directe.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DATABASE_POOL_MAX="1"
BETTER_AUTH_SECRET="generate-a-random-secret-with-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:13015"
# Dérogation temporaire seulement : "false" autorise l’accès sans confirmation d’adresse.
REQUIRE_EMAIL_VERIFICATION="true"
CRON_SECRET="generate-a-random-secret-with-at-least-16-characters"
LOG_LEVEL="info"
APP_VERSION="0.1.0"

# Resend est utilisé pour les emails d'authentification et les retours de suppression de compte.
# Laissez ces variables vides pour développer sans envoi d’email.
RESEND_API_KEY=""
EMAIL_FROM=""
ACCOUNT_DELETION_FEEDBACK_TO="irfanemlboa@gmail.com"

# Web Push — générez une paire VAPID par environnement.
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:notifications@example.com"

# Surveillance — toutes les variables restent facultatives en local.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Analytics respectueux de la vie privée : pages uniquement, sans replay ni saisie utilisateur.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
