{
  "name": "vintra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:deploy": "pnpm db:deploy && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "RUN_DATABASE_TESTS=true vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "quality:ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:integration && pnpm build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/nextjs": "^10.73.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "geist": "^1.5.1",
    "lucide-react": "^1.40.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "posthog-js": "^1.426.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "resend": "^6.26.0",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "15.5.20",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.7",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "^3.6.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js"
    ],
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ],
    "overrides": {
      "@hono/node-server": "1.19.13",
      "postcss": "8.5.19"
    }
  }
}
